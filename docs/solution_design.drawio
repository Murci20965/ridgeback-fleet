<mxfile host="app.diagrams.net"><diagram name="Solution design"><mxGraphModel dx="1920" dy="1080" grid="0" gridSize="10" page="1" pageWidth="1920" pageHeight="1080" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Ridgeback fleet data: production solution design" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=32;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1200" height="42" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eeeef2;strokeColor=#0071e3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="98" width="1880" height="172" as="geometry"/></mxCell><mxCell id="lanetitle0" value="Ingest: runs unattended every morning" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1880" height="32" as="geometry"/></mxCell><mxCell id="lane1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eeeef2;strokeColor=#0071e3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="318" width="1880" height="142" as="geometry"/></mxCell><mxCell id="lanetitle1" value="Store" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="1880" height="32" as="geometry"/></mxCell><mxCell id="lane2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eeeef2;strokeColor=#0071e3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="508" width="1880" height="344" as="geometry"/></mxCell><mxCell id="lanetitle2" value="Serve: dashboard and chat" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="1880" height="32" as="geometry"/></mxCell><mxCell id="lane3" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eeeef2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="1880" height="168" as="geometry"/></mxCell><mxCell id="lanetitle3" value="When files are late, missing or corrupt" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=25;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="20" y="862" width="1880" height="32" as="geometry"/></mxCell><mxCell id="providertitle" value="Telematics provider" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="320" height="30" as="geometry"/></mxCell><mxCell id="provider" value="Sends yesterday&amp;#x27;s events&lt;br&gt;as a CSV at 04:00" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86868b;strokeWidth=2;fontSize=19;fontColor=#3a3a3c;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="144" width="320" height="110" as="geometry"/></mxCell><mxCell id="sftptitle" value="SFTP folder" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="420" y="108" width="320" height="30" as="geometry"/></mxCell><mxCell id="sftp" value="Client&amp;#x27;s folder&lt;br&gt;Stands in for data/incoming&lt;br&gt;in this build" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86868b;strokeWidth=2;fontSize=19;fontColor=#3a3a3c;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="420" y="144" width="320" height="110" as="geometry"/></mxCell><mxCell id="runnertitle" value="Scheduled runner" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="800" y="108" width="320" height="30" as="geometry"/></mxCell><mxCell id="runner" value="GitHub Actions cron, 04:00 SAST&lt;br&gt;Retries hourly until 07:00&lt;br&gt;Option: n8n Schedule trigger" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86868b;strokeWidth=2;fontSize=19;fontColor=#3a3a3c;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="800" y="144" width="320" height="110" as="geometry"/></mxCell><mxCell id="pipelinetitle" value="Python pipeline" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="1180" y="108" width="320" height="30" as="geometry"/></mxCell><mxCell id="pipeline" value="Cleans rows, oldest file first&lt;br&gt;One transaction per file&lt;br&gt;Safe to rerun: unique event keys" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86868b;strokeWidth=2;fontSize=19;fontColor=#3a3a3c;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="1180" y="144" width="320" height="110" as="geometry"/></mxCell><mxCell id="alerttitle" value="Alerts" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#b00012;" vertex="1" parent="1"><mxGeometry x="1560" y="108" width="320" height="30" as="geometry"/></mxCell><mxCell id="alert" value="Email or Slack webhook&lt;br&gt;Failed, partial or missing files" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d70015;