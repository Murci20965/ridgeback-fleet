<mxfile host="app.diagrams.net"><diagram name="Solution design"><mxGraphModel dx="1500" dy="1120" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1120"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="Ingest: runs unattended every morning" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f6f6f3;strokeColor=#c3c2b7;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=15;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="1440" height="215" as="geometry"/></mxCell><mxCell id="lane1" value="Store" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f6f6f3;strokeColor=#c3c2b7;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=15;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="1440" height="165" as="geometry"/></mxCell><mxCell id="lane2" value="Serve: dashboard and chat" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f6f6f3;strokeColor=#c3c2b7;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=15;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="1440" height="310" as="geometry"/></mxCell><mxCell id="lane3" value="When files are late, missing or corrupt" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f6f6f3;strokeColor=#c3c2b7;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;fontSize=15;fontColor=#52514e;" vertex="1" parent="1"><mxGeometry x="30" y="805" width="1440" height="285" as="geometry"/></mxCell><mxCell id="provider" value="&lt;b&gt;Telematics provider&lt;/b&gt;&lt;br&gt;Sends yesterday&amp;#x27;s events&lt;br&gt;as a CSV at 04:00" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0efec;strokeColor=#6f6d68;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="55" y="125" width="200" height="120" as="geometry"/></mxCell><mxCell id="sftp" value="&lt;b&gt;SFTP folder&lt;/b&gt;&lt;br&gt;Client&amp;#x27;s folder&lt;br&gt;Stands in for data/incoming&lt;br&gt;in this build" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0efec;strokeColor=#6f6d68;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="305" y="125" width="200" height="120" as="geometry"/></mxCell><mxCell id="runner" value="&lt;b&gt;Scheduled runner&lt;/b&gt;&lt;br&gt;GitHub Actions cron, 04:00 SAST&lt;br&gt;Retries hourly until 07:00&lt;br&gt;Option: n8n Schedule trigger" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="555" y="125" width="260" height="120" as="geometry"/></mxCell><mxCell id="pipeline" value="&lt;b&gt;Python pipeline&lt;/b&gt;&lt;br&gt;Cleans rows, oldest file first&lt;br&gt;One transaction per file&lt;br&gt;Safe to rerun: unique event keys" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="865" y="125" width="320" height="120" as="geometry"/></mxCell><mxCell id="alert" value="&lt;b&gt;Alerts&lt;/b&gt;&lt;br&gt;Email or Slack webhook&lt;br&gt;On failed, partial or&lt;br&gt;missing files" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fcebeb;strokeColor=#a32d2d;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="1235" y="125" width="210" height="120" as="geometry"/></mxCell><mxCell id="archive" value="&lt;b&gt;Object storage (production)&lt;/b&gt;&lt;br&gt;Raw files kept as delivered&lt;br&gt;Bad files moved to quarantine" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1f5ee;strokeColor=#0f6e56;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="55" y="345" width="330" height="95" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Neon Postgres&lt;/b&gt;&lt;br&gt;telemetry_events, machines, drivers, branches&lt;br&gt;Views: v_machine_daily_hours, v_driver_events, v_branch_daily" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1f5ee;strokeColor=#0f6e56;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="435" y="345" width="480" height="95" as="geometry"/></mxCell><mxCell id="log" value="&lt;b&gt;Run log in Postgres&lt;/b&gt;&lt;br&gt;ingest_runs: file, rows loaded and rejected, outcome&lt;br&gt;rejected_rows: raw row and the reason" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1f5ee;strokeColor=#0f6e56;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="965" y="345" width="480" height="95" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Operations manager&lt;/b&gt;&lt;br&gt;Browser on phone,&lt;br&gt;tablet or desktop" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0efec;strokeColor=#6f6d68;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="55" y="560" width="190" height="115" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;Next.js on Vercel&lt;/b&gt;&lt;br&gt;Dashboard and chat UI&lt;br&gt;No secrets, no database" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdeee8;strokeColor=#c2501f;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="300" y="530" width="240" height="85" as="geometry"/></mxCell><mxCell id="dashapi" value="&lt;b&gt;FastAPI: /api/v1/dashboard&lt;/b&gt;&lt;br&gt;Runs shared SQL queries&lt;br&gt;On each page view, cached 60s" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdeee8;strokeColor=#c2501f;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="590" y="530" width="250" height="85" as="geometry"/></mxCell><mxCell id="chatapi" value="&lt;b&gt;FastAPI: /api/v1/chat&lt;/b&gt;&lt;br&gt;Rate limit, length limit&lt;br&gt;Tool loop, 5 rounds at most&lt;br&gt;Runs when a question is sent" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdeee8;strokeColor=#c2501f;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="300" y="660" width="240" height="100" as="geometry"/></mxCell><mxCell id="tools" value="&lt;b&gt;Typed read-only tools&lt;/b&gt;&lt;br&gt;Run hours, events, fleet, coverage&lt;br&gt;Validated, parameterised SQL&lt;br&gt;No free-form SQL" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1f5ee;strokeColor=#0f6e56;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="590" y="660" width="250" height="100" as="geometry"/></mxCell><mxCell id="guard" value="&lt;b&gt;Answer guard&lt;/b&gt;&lt;br&gt;Figure not in a tool result:&lt;br&gt;one retry, then withheld" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdeee8;strokeColor=#c2501f;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="890" y="530" width="250" height="85" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;OpenRouter (LLM call)&lt;/b&gt;&lt;br&gt;Claude Haiku 5.5, then fallback&lt;br&gt;Called only from FastAPI&lt;br&gt;Spend cap on the key" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#efedfb;strokeColor=#6250d6;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="890" y="660" width="250" height="100" as="geometry"/></mxCell><mxCell id="secrets" value="&lt;b&gt;Where secrets live&lt;/b&gt;&lt;br&gt;Vercel env vars:&lt;br&gt;OPENROUTER_API_KEY&lt;br&gt;DATABASE_URL (read-only role)&lt;br&gt;&lt;br&gt;GitHub Actions secret:&lt;br&gt;DATABASE_URL (owner role)&lt;br&gt;&lt;br&gt;Never in the repo or browser" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff6dd;strokeColor=#b97f00;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="1190" y="530" width="255" height="230" as="geometry"/></mxCell><mxCell id="late" value="&lt;b&gt;Late data&lt;/b&gt;&lt;br&gt;A row keeps its event date, wherever&lt;br&gt;it arrives, up to 7 days old&lt;br&gt;Resent rows hit the unique key,&lt;br&gt;so they load once&lt;br&gt;A late file loads on the next retry&lt;br&gt;Older rows are rejected with a reason" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fcebeb;strokeColor=#a32d2d;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="55" y="860" width="330" height="205" as="geometry"/></mxCell><mxCell id="missing" value="&lt;b&gt;Missing file&lt;/b&gt;&lt;br&gt;No file by 07:00: alert the on-call&lt;br&gt;contact&lt;br&gt;A gap between delivery dates is logged&lt;br&gt;Dashboard shows the last loaded date&lt;br&gt;Chat states which dates it covers&lt;br&gt;Backfills load in date order" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fcebeb;strokeColor=#a32d2d;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="410" y="860" width="330" height="205" as="geometry"/></mxCell><mxCell id="corrupt" value="&lt;b&gt;Corrupt file&lt;/b&gt;&lt;br&gt;Empty, not UTF-8 or missing a column:&lt;br&gt;roll back only that file, log failed&lt;br&gt;Later files still load&lt;br&gt;The run exits non-zero and alerts&lt;br&gt;The file is quarantined, and a&lt;br&gt;corrected copy reloads automatically" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fcebeb;strokeColor=#a32d2d;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="765" y="860" width="330" height="205" as="geometry"/></mxCell><mxCell id="badrow" value="&lt;b&gt;Bad rows in a good file&lt;/b&gt;&lt;br&gt;Stored in rejected_rows with a reason&lt;br&gt;Good rows still load&lt;br&gt;Truncated file: outcome is partial,&lt;br&gt;flagged on the dashboard&lt;br&gt;Unknown machine: held until it&amp;#x27;s on&lt;br&gt;the list, then reprocessed" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fcebeb;strokeColor=#a32d2d;fontSize=13;fontColor=#0b0b0b;" vertex="1" parent="1"><mxGeometry x="1120" y="860" width="325" height="205" as="geometry"/></mxCell><mxCell id="edge0" value="04:00 drop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="provider" target="sftp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge1" value="reads new files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="sftp" target="runner"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="runner" target="pipeline"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="on problems" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="pipeline" target="alert"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="loads events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="pipeline" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="logs each run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="pipeline" target="log"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="copy of raw file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="sftp" target="archive"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge7" value="opens page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="browser" target="web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge8" value="asks question" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="browser" target="chatapi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge9" value="server fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="web" target="dashapi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge10" value="tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="chatapi" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge11" value="draft answer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="llm" target="guard"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge12" value="asks model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="chatapi" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge13" value="checked answer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="guard" target="browser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge14" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="dashapi" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge15" value="read-only SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#52514e;fontSize=12;" edge="1" parent="1" source="tools" target="db"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
