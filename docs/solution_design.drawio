<mxfile host="app.diagrams.net"><diagram name="Solution design"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" page="1" pageWidth="1600" pageHeight="900" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Ridgeback fleet data: production solution design" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="32" as="geometry"/></mxCell><mxCell id="lane0" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f5f7;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="72" width="1560" height="126" as="geometry"/></mxCell><mxCell id="lanetitle0" value="Ingest: runs unattended every morning" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1560" height="26" as="geometry"/></mxCell><mxCell id="lane1" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f5f7;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="232" width="1560" height="106" as="geometry"/></mxCell><mxCell id="lanetitle1" value="Store" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="20" y="202" width="1560" height="26" as="geometry"/></mxCell><mxCell id="lane2" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f5f7;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="372" width="1560" height="296" as="geometry"/></mxCell><mxCell id="lanetitle2" value="Serve: dashboard and chat" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="20" y="342" width="1560" height="26" as="geometry"/></mxCell><mxCell id="lane3" value="" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f5f7;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="1560" height="186" as="geometry"/></mxCell><mxCell id="lanetitle3" value="When files are late, missing or corrupt" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="1560" height="26" as="geometry"/></mxCell><mxCell id="providertitle" value="Telematics provider" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="230" height="26" as="geometry"/></mxCell><mxCell id="provider" value="Sends yesterday&amp;#x27;s events&lt;br&gt;as a CSV at 04:00" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d2d2d7;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="230" height="80" as="geometry"/></mxCell><mxCell id="sftptitle" value="SFTP folder" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="230" height="26" as="geometry"/></mxCell><mxCell id="sftp" value="Client&amp;#x27;s folder&lt;br&gt;Stands in for data/incoming&lt;br&gt;in this build" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d2d2d7;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="300" y="108" width="230" height="80" as="geometry"/></mxCell><mxCell id="runnertitle" value="Scheduled runner" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="310" height="26" as="geometry"/></mxCell><mxCell id="runner" value="GitHub Actions cron, 04:00 SAST&lt;br&gt;Retries hourly until 07:00&lt;br&gt;Option: n8n Schedule trigger" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d2d2d7;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="560" y="108" width="310" height="80" as="geometry"/></mxCell><mxCell id="pipelinetitle" value="Python pipeline" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="310" height="26" as="geometry"/></mxCell><mxCell id="pipeline" value="Cleans rows, oldest file first&lt;br&gt;One transaction per file&lt;br&gt;Safe to rerun: unique event keys" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d2d2d7;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="900" y="108" width="310" height="80" as="geometry"/></mxCell><mxCell id="alerttitle" value="Alerts" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#b00012;" vertex="1" parent="1"><mxGeometry x="1240" y="80" width="320" height="26" as="geometry"/></mxCell><mxCell id="alert" value="Email or Slack webhook&lt;br&gt;On failed, partial or missing files" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d70015;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1240" y="108" width="320" height="80" as="geometry"/></mxCell><mxCell id="archivetitle" value="Object storage (production)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="360" height="26" as="geometry"/></mxCell><mxCell id="archive" value="Raw files kept as delivered&lt;br&gt;Bad files moved to quarantine" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8e8ed;strokeColor=#c7c7cc;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="360" height="60" as="geometry"/></mxCell><mxCell id="dbtitle" value="Neon Postgres" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="430" y="240" width="640" height="26" as="geometry"/></mxCell><mxCell id="db" value="telemetry_events, machines, drivers, branches&lt;br&gt;Views: v_machine_daily_hours, v_driver_events, v_branch_daily" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8e8ed;strokeColor=#c7c7cc;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="430" y="268" width="640" height="60" as="geometry"/></mxCell><mxCell id="logtitle" value="Run log" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="1100" y="240" width="460" height="26" as="geometry"/></mxCell><mxCell id="log" value="Postgres ingest_runs: file, rows loaded, rejected, outcome&lt;br&gt;Postgres rejected_rows: raw row and the reason" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8e8ed;strokeColor=#c7c7cc;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1100" y="268" width="460" height="60" as="geometry"/></mxCell><mxCell id="browsertitle" value="Operations manager" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="200" height="26" as="geometry"/></mxCell><mxCell id="browser" value="Browser on phone,&lt;br&gt;tablet or desktop" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d2d2d7;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="408" width="200" height="196" as="geometry"/></mxCell><mxCell id="webtitle" value="Next.js on Vercel" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="290" y="380" width="260" height="26" as="geometry"/></mxCell><mxCell id="web" value="Dashboard and chat UI&lt;br&gt;No secrets, no database" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d2d2d7;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="290" y="408" width="260" height="80" as="geometry"/></mxCell><mxCell id="dashapititle" value="FastAPI: /api/v1/dashboard" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="600" y="380" width="300" height="26" as="geometry"/></mxCell><mxCell id="dashapi" value="Runs shared SQL queries&lt;br&gt;On each page view, cached 60s" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d2d2d7;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="600" y="408" width="300" height="80" as="geometry"/></mxCell><mxCell id="llmtitle" value="OpenRouter (LLM call)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#0058b0;" vertex="1" parent="1"><mxGeometry x="950" y="380" width="280" height="26" as="geometry"/></mxCell><mxCell id="llm" value="Claude Haiku 5.5, then fallback&lt;br&gt;Called only from FastAPI&lt;br&gt;Spend cap on the key" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f2fd;strokeColor=#0071e3;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="950" y="408" width="280" height="80" as="geometry"/></mxCell><mxCell id="chatapititle" value="FastAPI: /api/v1/chat" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="290" y="496" width="260" height="26" as="geometry"/></mxCell><mxCell id="chatapi" value="Rate limit, length limit&lt;br&gt;Tool loop, 5 rounds at most&lt;br&gt;Runs when a question is sent" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d2d2d7;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="290" y="524" width="260" height="80" as="geometry"/></mxCell><mxCell id="toolstitle" value="Typed read-only tools" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="600" y="496" width="300" height="26" as="geometry"/></mxCell><mxCell id="tools" value="Run hours, events, fleet, coverage&lt;br&gt;Validated, parameterised SQL&lt;br&gt;No free-form SQL" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8e8ed;strokeColor=#c7c7cc;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="600" y="524" width="300" height="80" as="geometry"/></mxCell><mxCell id="guardtitle" value="Answer guard" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="950" y="496" width="280" height="26" as="geometry"/></mxCell><mxCell id="guard" value="Figure not in a tool result:&lt;br&gt;one retry, then withheld" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d2d2d7;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="950" y="524" width="280" height="80" as="geometry"/></mxCell><mxCell id="secretstitle" value="Where secrets live" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="1270" y="380" width="290" height="26" as="geometry"/></mxCell><mxCell id="secrets" value="Vercel env vars:&lt;br&gt;OPENROUTER_API_KEY&lt;br&gt;DATABASE_URL (read-only role)&lt;br&gt;&lt;br&gt;GitHub Actions secret:&lt;br&gt;DATABASE_URL (owner role)&lt;br&gt;&lt;br&gt;Never in the repo or browser" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1d1d1f;strokeColor=#1d1d1f;fontSize=16;fontColor=#f5f5f7;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1270" y="408" width="290" height="244" as="geometry"/></mxCell><mxCell id="latetitle" value="Late data" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#b00012;" vertex="1" parent="1"><mxGeometry x="40" y="708" width="365" height="26" as="geometry"/></mxCell><mxCell id="late" value="A row keeps its event date, wherever&lt;br&gt;it arrives, up to 7 days old&lt;br&gt;Resent rows hit the unique key,&lt;br&gt;so they load once&lt;br&gt;A late file loads on the next retry&lt;br&gt;Older rows are rejected with a reason" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d70015;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="736" width="365" height="140" as="geometry"/></mxCell><mxCell id="missingtitle" value="Missing file" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#b00012;" vertex="1" parent="1"><mxGeometry x="425" y="708" width="365" height="26" as="geometry"/></mxCell><mxCell id="missing" value="No file by 07:00: alert the&lt;br&gt;on-call contact&lt;br&gt;A gap between delivery dates is logged&lt;br&gt;Dashboard shows the last loaded date&lt;br&gt;Chat states which dates it covers&lt;br&gt;Backfills load in date order" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d70015;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="425" y="736" width="365" height="140" as="geometry"/></mxCell><mxCell id="corrupttitle" value="Corrupt file" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#b00012;" vertex="1" parent="1"><mxGeometry x="810" y="708" width="365" height="26" as="geometry"/></mxCell><mxCell id="corrupt" value="Empty, not UTF-8 or missing a column:&lt;br&gt;roll back only that file, log failed&lt;br&gt;Later files still load&lt;br&gt;The run exits non-zero and alerts&lt;br&gt;The file is quarantined, and a&lt;br&gt;corrected copy reloads automatically" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d70015;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="810" y="736" width="365" height="140" as="geometry"/></mxCell><mxCell id="badrowtitle" value="Bad rows in a good file" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#b00012;" vertex="1" parent="1"><mxGeometry x="1195" y="708" width="365" height="26" as="geometry"/></mxCell><mxCell id="badrow" value="Stored in rejected_rows with a reason&lt;br&gt;Good rows still load&lt;br&gt;Truncated file: outcome is partial,&lt;br&gt;flagged on the dashboard&lt;br&gt;Unknown machine: held until it&amp;#x27;s on&lt;br&gt;the list, then reprocessed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d70015;fontSize=16;fontColor=#515154;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1195" y="736" width="365" height="140" as="geometry"/></mxCell><mxCell id="edge0" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6e6e73;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="provider" target="sftp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6e6e73;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="sftp" target="runner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6e6e73;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="runner" target="pipeline"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mx