d reason" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dcdce2;strokeColor=#86868b;strokeWidth=2;fontSize=19;fontColor=#1d1d1f;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="1360" y="364" width="520" height="80" as="geometry"/></mxCell><mxCell id="browsertitle" value="Operations manager" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="40" y="518" width="240" height="30" as="geometry"/></mxCell><mxCell id="browser" value="Browser on phone,&lt;br&gt;tablet or desktop" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86868b;strokeWidth=2;fontSize=19;fontColor=#3a3a3c;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="554" width="240" height="206" as="geometry"/></mxCell><mxCell id="webtitle" value="Next.js on Vercel" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="370" y="518" width="320" height="30" as="geometry"/></mxCell><mxCell id="web" value="Dashboard and chat UI&lt;br&gt;No secrets, no database" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86868b;strokeWidth=2;fontSize=19;fontColor=#3a3a3c;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="370" y="554" width="320" height="80" as="geometry"/></mxCell><mxCell id="dashapititle" value="FastAPI: /api/v1/dashboard" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="760" y="518" width="350" height="30" as="geometry"/></mxCell><mxCell id="dashapi" value="Runs shared SQL queries&lt;br&gt;On each page view, cached 60s" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86868b;strokeWidth=2;fontSize=19;fontColor=#3a3a3c;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="760" y="554" width="350" height="80" as="geometry"/></mxCell><mxCell id="llmtitle" value="OpenRouter (LLM call)" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#0058b0;" vertex="1" parent="1"><mxGeometry x="1190" y="518" width="320" height="30" as="geometry"/></mxCell><mxCell id="llm" value="Claude Haiku 5.5, with fallback&lt;br&gt;Called only from FastAPI" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dcebfc;strokeColor=#0071e3;strokeWidth=2;fontSize=19;fontColor=#1d1d1f;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="1190" y="554" width="320" height="80" as="geometry"/></mxCell><mxCell id="chatapititle" value="FastAPI: /api/v1/chat" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="370" y="644" width="320" height="30" as="geometry"/></mxCell><mxCell id="chatapi" value="Rate and length limits&lt;br&gt;Tool loop, 5 rounds at most" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86868b;strokeWidth=2;fontSize=19;fontColor=#3a3a3c;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="370" y="680" width="320" height="80" as="geometry"/></mxCell><mxCell id="toolstitle" value="Typed read-only tools" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="760" y="644" width="350" height="30" as="geometry"/></mxCell><mxCell id="tools" value="Run hours, events, fleet, coverage&lt;br&gt;Parameterised SQL, none free-form" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dcdce2;strokeColor=#86868b;strokeWidth=2;fontSize=19;fontColor=#1d1d1f;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="760" y="680" width="350" height="80" as="geometry"/></mxCell><mxCell id="guardtitle" value="Answer guard" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="1190" y="644" width="320" height="30" as="geometry"/></mxCell><mxCell id="guard" value="Figure not in a tool result:&lt;br&gt;one retry, then withheld" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86868b;strokeWidth=2;fontSize=19;fontColor=#3a3a3c;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="1190" y="680" width="320" height="80" as="geometry"/></mxCell><mxCell id="secretstitle" value="Where secrets live" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#1d1d1f;" vertex="1" parent="1"><mxGeometry x="1580" y="518" width="300" height="30" as="geometry"/></mxCell><mxCell id="secrets" value="Vercel env vars:&lt;br&gt;OPENROUTER_API_KEY&lt;br&gt;DATABASE_URL (read-only)&lt;br&gt;The key has a spend cap&lt;br&gt;&lt;br&gt;GitHub Actions secret:&lt;br&gt;DATABASE_URL (owner)&lt;br&gt;&lt;br&gt;Never in the repo or browser" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1d1d1f;strokeColor=#1d1d1f;strokeWidth=2;fontSize=19;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="1580" y="554" width="300" height="286" as="geometry"/></mxCell><mxCell id="latetitle" value="Late data" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#b00012;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="437" height="30" as="geometry"/></mxCell><mxCell id="late" value="Rows keep their event date, up to 7 days old&lt;br&gt;Resent rows load once, by unique key&lt;br&gt;A late file loads on the next retry" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d70015;strokeWidth=2;fontSize=19;fontColor=#3a3a3c;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="946" width="437" height="106" as="geometry"/></mxCell><mxCell id="missingtitle" value="Missing file" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#b00012;" vertex="1" parent="1"><mxGeometry x="507" y="910" width="437" height="30" as="geometry"/></mxCell><mxCell id="missing" value="No file by 07:00 alerts the on-call contact&lt;br&gt;Gaps between delivery dates are logged&lt;br&gt;Dashboard and chat show the dates covered" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d70015;strokeWidth=2;fontSize=19;fontColor=#3a3a3c;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="507" y="946" width="437" height="106" as="geometry"/></mxCell><mxCell id="corrupttitle" value="Corrupt file" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#b00012;" vertex="1" parent="1"><mxGeometry x="974" y="910" width="437" height="30" as="geometry"/></mxCell><mxCell id="corrupt" value="Rolls back that file only, and logs it failed&lt;br&gt;Later files still load, and the run alerts&lt;br&gt;Quarantined until a corrected copy arrives" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d70015;strokeWidth=2;fontSize=19;fontColor=#3a3a3c;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="974" y="946" width="437" height="106" as="geometry"/></mxCell><mxCell id="badrowtitle" value="Bad rows in a good file" style="text;html=1;whiteSpace=nowrap;strokeColor=none;fillColor=none;spacing=0;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#b00012;" vertex="1" parent="1"><mxGeometry x="1443" y="910" width="437" height="30" as="geometry"/></mxCell><mxCell id="badrow" value="Stored in rejected_rows with a reason&lt;br&gt;Good rows load; truncated means partial&lt;br&gt;Unknown machines held until listed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d70015;strokeWidth=2;fontSize=19;fontColor=#3a3a3c;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="1443" y="946" width="437" height="106" as="geometry"/></mxCell><mxCell id="edge0" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#48484a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="provider" target="sftp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#48484a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="sftp" target="runner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#48484a;strokeWidth=2;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="runner" target="pipeline"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#48484a;strokeWidth=2;exitX=1.00