# Copy this file to .env and fill in your values. Never commit .env.
OPENROUTER_API_KEY=

# The local API uses this. In production the API uses a read-only role and the pipeline uses
# the owner role. See pipeline/sql/roles/readonly_role.sql.
DATABASE_URL=

# The value to give the live API as its DATABASE_URL: pooled host, read-only role.
DATABASE_URL_READONLY=

# Optional. A comma-separated fallback list that overrides the default models.
OPENROUTER_MODELS=
